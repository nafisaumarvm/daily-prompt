# =============================================================================
# Daily Prompt — Environment Variables
# Copy this file to `.env.local` and fill in the values.
# =============================================================================

# --- Supabase (preferred for production) ---
# Create a project at https://supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Service role key is used by API routes / cron (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- Optional: local / LAN defaults when not using Supabase device_config ---
# Example LAN: 192.168.1.42
# Example Tailscale: https://ulanzi.tailnet-name.ts.net
ULANZI_DEFAULT_URL=
ULANZI_WEBHOOK_RELAY=

# --- Vercel Cron security ---
# Set the same value in Vercel Project → Settings → Environment Variables.
# Vercel sends Authorization: Bearer <CRON_SECRET> on cron invocations.
CRON_SECRET=generate_a_long_random_string

# =============================================================================
# Local development without Supabase
# Leave NEXT_PUBLIC_SUPABASE_* empty — the app stores questions in `.data/`
# and seeds 50 starter couple questions automatically.
# =============================================================================
